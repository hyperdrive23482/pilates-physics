{
  "functions": {
    "api/stripe/webhook.js": {
      "includeFiles": "supabase/email-templates/**"
    },
    "api/springs101.js": {
      "includeFiles": "supabase/email-templates/**"
    },
    "api/admin/animations-list.js": {
      "includeFiles": "animations/**"
    },
    "api/admin/animation.js": {
      "includeFiles": "animations/**"
    },
    "api/portal/animation.js": {
      "includeFiles": "animations/**"
    },
    "api/certificate/[workshopId].js": {
      "includeFiles": "public/images/about/kaleen_signature.png"
    },
    "api/cron/mint-offers.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/redact-activity",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/mint-offers",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/offer/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/((?!api/|ingest/|sitemap\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
