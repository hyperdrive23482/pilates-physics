{
  "functions": {
    "api/stripe/webhook.js": {
      "includeFiles": "supabase/email-templates/**"
    },
    "api/admin/animations-list.js": {
      "includeFiles": "animations/**"
    },
    "api/admin/animation.js": {
      "includeFiles": "animations/**"
    },
    "api/portal/animation.js": {
      "includeFiles": "animations/**"
    },
    "api/certificate/[webinarId].js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/_assets/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
