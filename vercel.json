{
  "functions": {
    "api/stripe/webhook.js": {
      "includeFiles": "supabase/email-templates/**"
    },
    "api/springs101.js": {
      "includeFiles": "supabase/email-templates/**"
    },
    "api/admin/animations-list.js": {
      "includeFiles": "animations/**"
    },
    "api/admin/animation.js": {
      "includeFiles": "animations/**"
    },
    "api/portal/animation.js": {
      "includeFiles": "animations/**"
    },
    "api/certificate/[workshopId].js": {
      "includeFiles": "public/images/about/kaleen_signature.png"
    },
    "api/cron/mint-offers.js": {
      "maxDuration": 60
    },
    "api/admin/funnel.js": {
      "maxDuration": 60
    },
    "api/admin/funnel-traffic.js": {
      "maxDuration": 60
    },
    "api/render-page.js": {
      "includeFiles": "dist/app-shell.html"
    },
    "api/admin/seo.js": {
      "maxDuration": 300
    },
    "api/cron/seo-audit.js": {
      "maxDuration": 120
    },
    "api/cron/seo-search-sync.js": {
      "maxDuration": 120
    },
    "api/cron/seo-index-inspect.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/redact-activity",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/mint-offers",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/seo-search-sync",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/seo-audit",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/seo-index-inspect",
      "schedule": "30 9 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(login|signup|forgot-password|set-password|profile|subscription-confirmed)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(portal|admin|auth|survey|survey-101)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/offer/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/",
      "destination": "/api/render-page?path=/"
    },
    {
      "source": "/:page(about|spring-calculator|education|how-a-reformer-works|pilates-physics-101|pilates-physics-102|mentorship|scholarship|blog|help|terms|privacy|links)",
      "destination": "/api/render-page?path=/:page"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/render-page?path=/blog/:slug"
    },
    {
      "source": "/((?!api/|ingest/|sitemap\\.xml$).*)",
      "destination": "/app-shell.html"
    }
  ]
}
