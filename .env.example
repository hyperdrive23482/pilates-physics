VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (Vercel function env vars):
# SUPABASE_SERVICE_ROLE_KEY=...
# STRIPE_SECRET_KEY=...
# RESEND_API_KEY=...
# KIT_API_KEY=...

# Optional: name of the Kit email template to use when the content portal
# creates a broadcast. Defaults to "Newsletter Template". The name must match
# exactly what's in your Kit account (case-sensitive).
# KIT_BROADCAST_TEMPLATE=Newsletter Template

# Id of a SINGLE opt-in Kit form used purely to activate buyers. Kit's API has
# no way to set a subscriber's state, and a buyer who first arrived as an
# unconfirmed lead stays `inactive` forever -- tagged, but excluded from Kit's
# UI and from every broadcast audience, which all default to active-only.
# Adding them to a single opt-in form is the documented way back. The form is
# never embedded anywhere; it only exists as this switch. Create it with the
# incentive/confirmation email turned OFF, or it will just email buyers another
# confirmation they already ignored once. Unset, api/_lib/kit.js raises a loud
# kit_failed on the affected purchase rather than tagging into the void.
# KIT_PURCHASE_FORM_ID=9930844

# Anthropic API key for the content management portal's drafting feature.
# ANTHROPIC_API_KEY=sk-ant-...

# Shared secret used to authorize cron requests (Vercel Cron sets the header
# `Authorization: Bearer ${CRON_SECRET}` when CRON_SECRET is set in env).
# CRON_SECRET=...

# Shared secret for api/admin/content/brain-ingest.js, which the local
# reel-brain skill uses to read and upsert brain_entries without an admin
# login. Set it in Vercel (prod) AND in your local .env, where the skill
# also reads BRAIN_INGEST_URL (e.g. https://pilatesphysics.com/api/admin/content/brain-ingest).
# Unset in Vercel, the endpoint refuses every request.
# BRAIN_INGEST_SECRET=...
# BRAIN_INGEST_URL=https://pilatesphysics.com/api/admin/content/brain-ingest

# The $39 Stripe Price on the How a Reformer Works product, used by the
# subscriber offer path in api/checkout/create-session.js and by the PP101 order
# bump. ENVIRONMENT-SPECIFIC: a price id belongs to one Stripe mode, so this has
# to match the mode of STRIPE_SECRET_KEY in the same environment (a test price
# against a live key fails with "No such price"). Same trap as
# webinars.stripe_price_id, which migration 045 deliberately does not seed.
# Without it, a valid offer token returns a loud 500 rather than quietly
# charging full price.
# TRIPWIRE_OFFER_PRICE_ID=price_...

# Master switch for api/cron/mint-offers.js. Anything other than the exact
# string "true" runs the job as a DRY RUN: it reports who it would mint for and
# writes nothing. Deliberately fails closed, because minting cannot be undone
# from the outside -- it starts a four-day clock and writes a deadline into Kit,
# and a window that expires before the emails are sending has been spent for
# good (the unique index refuses a second one for the same campaign).
# Set to true only once the Kit cart sequence is actually sending.
# MINT_OFFERS_ENABLED=true

# Optional: recipient for the /help contact form. Defaults to kaleen@pilatesphysics.com.
# CONTACT_TO_EMAIL=kaleen@pilatesphysics.com

# ---------------------------------------------------------------------------
# PostHog (visitor analytics; docs/admin-analytics-engine-plan.md section 4.1)
# ---------------------------------------------------------------------------
# Client write key (phc_...). Project settings -> Project API key. Without it
# src/lib/posthog.js never loads the SDK and the site sends nothing, which is
# the right state for local dev. Set it in Vercel for Production AND Preview if
# previews should be visible in PostHog (they are filtered out of admin numbers
# by POSTHOG_PROD_HOST either way).
# VITE_POSTHOG_KEY=phc_...
# Where the browser sends events. Leave as /ingest: vercel.json rewrites it to
# PostHog so ad blockers do not drop it.
# VITE_POSTHOG_HOST=/ingest

# Server-side read access, used by the admin API to run HogQL queries. A
# personal API key (phx_...) with the "Query: Read" scope on this project, or
# a project secret key (phs_...) if it carries that scope. Settings -> Personal
# API keys. A personal key stops working if its owner is removed or rotates it.
# POSTHOG_API_KEY=phx_...
# Numeric project id, from the project settings URL.
# POSTHOG_PROJECT_ID=12345
# The query API host. us.posthog.com for a US Cloud project; NOT the /ingest proxy.
# POSTHOG_API_HOST=https://us.posthog.com
# Only pageviews on this host count as traffic. Previews and localhost share the
# project and are filtered out by it.
# POSTHOG_PROD_HOST=pilatesphysics.com

# PostHog (docs/admin-analytics-engine-plan.md, section 4.1). The project
# token is write-only and ships in the browser bundle on purpose; Vercel's
# "might expose sensitive information" warning on the VITE_ name is a false
# alarm for this one. Unset, src/lib/posthog.js never loads the SDK, so local
# dev and previews without the var send nothing. The host defaults to /ingest,
# the vercel.json rewrite to the US cloud that keeps ad blockers from dropping
# events; override only to point at PostHog directly.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=/ingest

# Server-only, for the admin Analytics and Funnel pages (not read yet). A
# Personal API key with Query: Read scope, never the phc_ project token, and
# the numeric project id from Settings > General. Store as Secret in Vercel.
# POSTHOG_API_KEY=phx_...
# POSTHOG_PROJECT_ID=12345
# POSTHOG_API_HOST=https://us.posthog.com
# POSTHOG_PROD_HOST=pilatesphysics.com
